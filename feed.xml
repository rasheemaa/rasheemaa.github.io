---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>The Sheema Edit</title>
    <link>{{ site.url }}/</link>
    <description>{{ site.description | xml_escape }}</description>
    {% assign edits = site.edits | sort: "date" | reverse %}
    {% for edit in edits %}
    <item>
      <title>{{ edit.title | xml_escape }}</title>
      <link>{{ site.url }}{{ edit.url }}</link>
      <guid>{{ site.url }}{{ edit.url }}</guid>
      <pubDate>{{ edit.date | date_to_rfc822 }}</pubDate>
      <description>{{ edit.description | xml_escape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
