---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc></url>
  <url><loc>{{ site.url }}/about.html</loc></url>
  {% assign edits = site.edits | sort: "date" | reverse %}
  {% for edit in edits %}
  <url>
    <loc>{{ site.url }}{{ edit.url }}</loc>
    <lastmod>{{ edit.date | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {% endfor %}
</urlset>
